from PyQt5 import QtCore
import time
from collections import defaultdict
import pyvisa
import threading

class CryoPasqal(QtCore.QThread):
    # 1. Variables de classe OBLIGATOIRES pour l'arbre du GUI
    name = 'CryoPasqal'
    type = 'Cryostat'

    def __init__(self, port_com='ASRL9::INSTR'):
        super(CryoPasqal, self).__init__()
        
        self.parameter_dict = defaultdict()
        self.parameter_dict['Set_T'] = 5
        self.parameter_dict['OnOff_comp'] = 0
        self.parameter_dict['OnOff_Loop'] = 0
        self.parameter_dict['ChannelA_T'] = 300
        self.parameter_dict['ChannelB_T'] = 300
        self.parameter_dict['ChannelC_T'] = 300
        self.parameter_dict['ChannelD_T'] = 300
        self.parameter_dict['MainController_T'] = 300
        
        self.parameter_display_dict = defaultdict(dict)
        self.parameter_display_dict['Set_T']['val'] = 5
        self.parameter_display_dict['Set_T']['unit'] = ' K'
        self.parameter_display_dict['Set_T']['max'] = 1000
        self.parameter_display_dict['Set_T']['read'] = False

        self.parameter_display_dict['OnOff_comp']['val'] = 0
        self.parameter_display_dict['OnOff_comp']['unit'] = ' '
        self.parameter_display_dict['OnOff_comp']['max'] = 1
        self.parameter_display_dict['OnOff_comp']['read'] = False

        self.parameter_display_dict['OnOff_Loop']['val'] = 0
        self.parameter_display_dict['OnOff_Loop']['unit'] = ' '
        self.parameter_display_dict['OnOff_Loop']['max'] = 1
        self.parameter_display_dict['OnOff_Loop']['read'] = False

        self.parameter_display_dict['ChannelA_T']['val'] = 300
        self.parameter_display_dict['ChannelA_T']['unit'] = ' K'
        self.parameter_display_dict['ChannelA_T']['max'] = 1000
        self.parameter_display_dict['ChannelA_T']['read'] = True

        self.parameter_display_dict['ChannelB_T']['val'] = 300
        self.parameter_display_dict['ChannelB_T']['unit'] = ' K'
        self.parameter_display_dict['ChannelB_T']['max'] = 1000
        self.parameter_display_dict['ChannelB_T']['read'] = True

        self.parameter_display_dict['ChannelC_T']['val'] = 300
        self.parameter_display_dict['ChannelC_T']['unit'] = ' K'
        self.parameter_display_dict['ChannelC_T']['max'] = 1000
        self.parameter_display_dict['ChannelC_T']['read'] = True

        self.parameter_display_dict['ChannelD_T']['val'] = 300
        self.parameter_display_dict['ChannelD_T']['unit'] = ' K'
        self.parameter_display_dict['ChannelD_T']['max'] = 1000
        self.parameter_display_dict['ChannelD_T']['read'] = True

        self.parameter_display_dict['MainController_T']['val'] = 300
        self.parameter_display_dict['MainController_T']['unit'] = ' K'
        self.parameter_display_dict['MainController_T']['max'] = 1000
        self.parameter_display_dict['MainController_T']['read'] = True

        # --- INITIALISATION PYVISA (Selon le manuel Optidry 250) ---
        self.port_com = port_com
        self.rm = pyvisa.ResourceManager()
        self.is_connected = False
        
        self.visa_lock = threading.Lock() 
        
        try:
            self.Opti = self.rm.open_resource(
                self.port_com,
                baud_rate=115200,
                data_bits=8,
                parity=pyvisa.constants.Parity.none,
                stop_bits=pyvisa.constants.StopBits.one,
                write_termination='\n',
                read_termination='\n',
                timeout=2000 # Ajout d'un timeout de 2 secondes
            )
            self.is_connected = True
        except pyvisa.errors.VisaIOError as e:
            print(f"Erreur d'initialisation VISA : {e}")
            self.is_connected = False

        self.waitTime = 0.5 # Je conseille 0.5s ou 1s, 0.1s c'est très rapide pour un port série

        # start updating temp (Note: L'UpdateWorker utilise encore requests pour l'instant)
        self.UpdateWorker = UpdateWorker(self.Opti, self.visa_lock, self.is_connected)
        self.UpdateWorker.new_T.connect(self.update_temp)
        self.UpdateWorker.start()
        

    # --- Fonction OBLIGATOIRE appelée par le GUI pour le contrôle ---
    def set_parameter(self, param, value):
        """Cette fonction est déclenchée quand on tape une valeur dans le GUI"""
        if param == 'Set_T':
            self.set_temperature(value)
            self.UpdateWorker.target = value
            
        elif param == 'OnOff_comp':
            if self.is_connected:
                # Exemple de commande pour le compresseur (à valider plus tard)
                # state = "ON" if value == 1 else "OFF"
                # self.Opti.write(f"CONTrol:COMPressor:STATe {state}")
                self.parameter_dict['OnOff_comp'] = value
                print(f"Commande compresseur changée à {value}")
            else:
                print("Erreur : Cryostat non connecté.")

    # --- Mise à jour des valeurs lues pour l'affichage ---
    def update_temp(self, temps_list):
        """Connecté au signal du UpdateWorker"""
        # À adapter selon le format renvoyé par pyvisa plus tard
        try:
            self.parameter_dict['ChannelA_T'] = temps_list[3] # Index selon ton format
        except TypeError:
             # Temporaire: si temps_list est un float (comme renvoyé par l'ancien script requests)
             self.parameter_dict['ChannelA_T'] = temps_list

    def set_temperature(self, target_temp):
        if not getattr(self, 'is_connected', False):
            print("Error, Impossible to change the temperature, Cryostat is not connected.")
            return

        try:
            # Commande SCPI tirée du manuel
            Commande = f'SOUR:TEMP:SPO 1, {target_temp}' # '1' pour le canal 1 par exemple
            self.Opti.write(Commande)
            print(f"Consigne envoyée au cryostat : {target_temp} K")

            self.parameter_dict['Set_T'] = target_temp
        except Exception as e:
            print(f"Erreur de communication VISA lors du changement de température : {e}") 
    def set_compressor_state(self, state_on):
        """Allume (True) ou éteint (False) le compresseur"""
        if not self.is_connected: return
        etat_str = "ON" if state_on else "OFF"
        
        with self.visa_lock:
            try:
                self.Opti.write(f"CONTrol:COMPressor:STATe {etat_str}")
                print(f"Compresseur mis sur : {etat_str}")
                self.parameter_dict['OnOff_comp'] = 1 if state_on else 0
            except Exception as e:
                print(f"Erreur compresseur : {e}")

    def reset_compressor(self):
        """Réinitialise le compresseur (utile après une alarme/coupure)"""
        if not self.is_connected: return
        with self.visa_lock:
            self.Opti.write("CONTrol:COMPressor:RESet")
            print("Commande de Reset envoyée au compresseur.")

    def set_heater_range(self, channel, range_level):
        """
        Définit la puissance max du heater.
        channel : 1, 2, 3 ou 4 (Canaux Lakeshore)
        range_level : dépend du Lakeshore (ex: 0=Off, 1=Low, 2=Med, 3=High)
        """
        if not self.is_connected: return
        with self.visa_lock:
            self.Opti.write(f"SOURCE:HEATer:RANGe {channel}, {range_level}")
            print(f"Heater Range du canal {channel} défini à {range_level}")

    def set_warmup_state(self, state_on):
        """Active ou désactive le réchauffement rapide"""
        if not self.is_connected: return
        etat_str = "ON" if state_on else "OFF"
        with self.visa_lock:
            self.Opti.write(f"CONTrol:WARMup:ENABle {etat_str}")
            print(f"Réchauffement rapide : {etat_str}")


    def close(self):    
        """Ferme proprement la connexion série avant de quitter"""
        if getattr(self, 'is_connected', False):
            self.Opti.close()
            print("Connexion au cryostat fermée.")
            self.is_connected = False


class UpdateWorker(QtCore.QThread):
    new_T = QtCore.pyqtSignal(list) # Modifié pour renvoyer une LISTE au lieu d'un float

    def __init__(self, instrument_visa, visa_lock, is_connected):
        super(UpdateWorker, self).__init__()
        self.stop = False
        self.waitTime = 1.0 # 1 seconde entre chaque lecture est plus stable
        
        # Récupération de la connexion VISA depuis la classe principale
        self.Opti = instrument_visa
        self.visa_lock = visa_lock
        self.is_connected = is_connected

    def run(self):
        while not self.stop:
            if self.is_connected:
                readtemp = self.read_T()
                if readtemp: # Si la lecture a réussi
                    self.new_T.emit(readtemp)
            
            time.sleep(self.waitTime)

    def read_T(self):
        """Lit les 4 canaux de température via SCPI"""
        try:
            with self.visa_lock: # On verrouille le port série pendant la lecture
                # La commande MEASure renvoie une chaîne ex: "295.1, 295.2, 4.2, 50.1"
                rep = self.Opti.query("MEASure:TEMPerature? (@1,2,3,4)")
            
            # On nettoie la chaîne et on la transforme en liste de floats
            temps_str = rep.strip().split(',')
            temps_float = [float(t) for t in temps_str]
            return temps_float
            
        except Exception as e:
            print(f"Erreur de lecture température: {e}")
            return [300.0, 300.0, 300.0, 300.0] # Valeurs par défaut en cas d'erreur